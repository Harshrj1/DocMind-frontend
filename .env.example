# ==============================================================================
# DocMind Frontend Environment Configuration (.env.example)
# Copy this file to .env or .env.local to customize your environment.
# ==============================================================================

# Backend API Base URL
# - In local development: Leave EMPTY to let Vite dev proxy route `/api` to `http://localhost:8080`.
# - In production (Vercel, Netlify, Render): Set to your deployed backend URL.
#   Example: VITE_API_BASE_URL=https://docmind-backend.onrender.com
#   (Do not include trailing slash; if included, the app automatically normalizes it)
VITE_API_BASE_URL=

# Optional: Override the backend URL used by Vite dev proxy (defaults to http://localhost:8080)
# VITE_BACKEND_URL=http://localhost:8080
